MACROSS_UI_STRING("controller.xbox_series", L"엑스박스 One/Series", L"Xbox One/Series", L"Xbox One/Series")
MACROSS_UI_STRING("controller.xbox360", L"엑스박스 360", L"Xbox 360", L"Xbox 360")
MACROSS_UI_STRING("controller.switch_pro", L"스위치 프로", L"Switch Pro", L"Switch Pro")
MACROSS_UI_STRING("controller.xinput", L"엑스박스 (XInput)", L"Xbox (XInput)", L"Xbox (XInput)")
MACROSS_UI_STRING("controller.generic", L"게임패드", L"Gamepad", L"ゲームパッド")
MACROSS_UI_STRING("controller.backend.sdl", L"입력 방식: SDL2 %hs  (듀얼센스·듀얼쇼크4·엑스박스·스위치 프로 등, USB/블루투스)", L"Input: SDL2 %hs (DualSense, DualShock 4, Xbox, Switch Pro; USB/Bluetooth)", L"入力: SDL2 %hs (DualSense、DualShock 4、Xbox、Switch Pro、USB/Bluetooth)")
MACROSS_UI_STRING("controller.backend.xinput", L"입력 방식: XInput  (엑스박스 패드만 — SDL2.dll이 없어 다른 패드는 인식하지 않음)", L"Input: XInput (Xbox only; SDL2.dll is missing)", L"入力: XInput (Xboxのみ。SDL2.dllがありません)")
MACROSS_UI_STRING("controller.not_initialized", L"게임이 아직 패드를 초기화하지 않았습니다.", L"The game has not initialized controllers yet.", L"ゲームがまだパッドを初期化していません。")
MACROSS_UI_STRING("controller.count", L"연결된 컨트롤러: %d개", L"Connected controllers: %d", L"接続中のコントローラー: %d台")
MACROSS_UI_STRING("controller.none", L"없음 — USB나 블루투스로 연결하면 여기에 바로 나타납니다 (게임 중 연결 가능).", L"None. Connect by USB or Bluetooth; hot-plugging is supported.", L"未接続です。USBまたはBluetoothで接続できます。プレイ中も接続可能です。")
MACROSS_UI_STRING("controller.device_status", L"%d. %s  —  %s      누름: %s", L"%d. %s — %s   Pressed: %s", L"%d. %s — %s   入力: %s")
MACROSS_UI_STRING("input.keyboard_status", L"키보드: %s", L"Keyboard: %s", L"キーボード: %s")
MACROSS_UI_STRING("input.pressed", L"누르는 중", L"Pressed", L"入力中")
MACROSS_UI_STRING("input.waiting", L"대기 (키 설정의 키를 누르면 아래에 함께 표시)", L"Waiting (configured keyboard input is shown below)", L"待機中 (設定したキーの入力も以下に表示されます)")
MACROSS_UI_STRING("input.combined", L"게임이 받는 입력 (패드 + 키보드)", L"Game input (controller + keyboard)", L"ゲームへの入力 (パッド＋キーボード)")
MACROSS_UI_STRING("controller.left_stick", L"왼쪽 스틱 (L3)", L"Left stick (L3)", L"左スティック (L3)")
MACROSS_UI_STRING("controller.right_stick", L"오른쪽 스틱 (R3)", L"Right stick (R3)", L"右スティック (R3)")
MACROSS_UI_STRING("input.paused", L"이 창이 열려 있는 동안은 게임에 입력이 가지 않습니다 (닫으면 다시 조작).", L"Input is paused while this window is open. Close it to resume.", L"このウィンドウを閉じるとゲーム操作に戻ります。")
MACROSS_UI_STRING("controller.test.title", L"컨트롤러 테스트", L"Controller test", L"コントローラーテスト")
MACROSS_UI_STRING("controller.test.vibration", L"진동 테스트", L"Test vibration", L"振動テスト")
MACROSS_UI_STRING("controller.bindings.title", L"패드 버튼 설정", L"Controller bindings", L"パッドボタン設定")
MACROSS_UI_STRING("controller.bindings.help", L"패드 버튼마다 게임에서 쓸 PS3 버튼을 고르세요. 모든 패드에 같이 바로 적용되고 저장됩니다.\n패드 버튼을 누르면 그 줄이 주황색으로 켜집니다. 스틱은 바꿀 수 없습니다.\n이 창이 열려 있는 동안은 게임에 입력이 가지 않습니다.", L"Choose a PS3 button for each controller button. Changes apply to all pads immediately.\nPress a controller button to highlight its row. Stick mappings are fixed.\nGame input is paused while this window is open.", L"各ボタンにPS3ボタンを割り当てます。全パッドに即時適用して保存します。\nボタンを押すと行が点灯します。スティックは変更できません。\nこのウィンドウを開いている間はゲームに入力されません。")
MACROSS_UI_STRING("controller.swap_confirm", L"✕ / ○ 서로 바꾸기", L"Swap Cross / Circle", L"✕ / ○を入れ替え")
MACROSS_UI_STRING("options.title", L"옵션 (F9)", L"Options (F9)", L"オプション (F9)")
MACROSS_UI_STRING("options.resolution", L"해상도 (내부 렌더)", L"Internal rendering resolution", L"内部描画解像度")
MACROSS_UI_STRING("options.resolution.original", L"1280 x 720 (원본)", L"1280 x 720 (original)", L"1280 x 720 (原本)")
MACROSS_UI_STRING("options.fullscreen", L"전체화면 (F11, Alt+Enter)", L"Fullscreen (F11, Alt+Enter)", L"全画面 (F11, Alt+Enter)")
MACROSS_UI_STRING("options.vsync", L"수직 동기화 (VSync)", L"Vertical sync (VSync)", L"垂直同期 (VSync)")
MACROSS_UI_STRING("options.bloom", L"블룸 (빛 번짐)", L"Bloom", L"ブルーム")
MACROSS_UI_STRING("options.uncap", L"30 FPS 제한 해제 (실험: 연출 속도 보정, 일부 타이밍 차이 가능)", L"Unlock 30 FPS cap (experimental; timing may differ)", L"30 FPS制限解除 (実験機能、一部タイミング差異あり)")
MACROSS_UI_STRING("options.uncap.unavailable", L"30 FPS 제한 해제 — 수정 중 (사용 불가)", L"Unlock 30 FPS cap — under repair (unavailable)", L"30 FPS制限解除 — 修正中（使用不可）")
MACROSS_UI_STRING("options.restart_help.locked", L"이 빌드는 30 FPS 제한을 유지합니다. 제한 해제 기능은 수정 중입니다.\n해상도 변경은 게임을 다시 실행하면 적용됩니다.\n전체화면·수직동기·블룸·자막은 즉시 적용됩니다.", L"This build keeps the 30 FPS cap. Unlocking is under repair.\nResolution changes apply after restarting the game.\nFullscreen, VSync, bloom and subtitles apply immediately.", L"このビルドは30 FPS制限を維持します。制限解除は修正中です。\n解像度はゲーム再起動後に適用されます。\n全画面・垂直同期・ブルーム・字幕は即時適用です。")
MACROSS_UI_STRING("options.subtitles", L"자막 표시 (영상·전투)", L"Subtitles (movies and battle)", L"字幕表示 (ムービー・戦闘)")
MACROSS_UI_STRING("options.restart_help", L"전체화면·수직동기·블룸·자막·30 FPS 제한은 즉시 적용됩니다.\n해상도는 게임을 다시 실행하면 적용됩니다.\n프레임 제한을 전환해도 게임 시간 보정은 유지됩니다. 제한 해제는 실험 기능입니다.", L"Fullscreen, VSync, bloom, subtitles and the 30 FPS cap apply immediately.\nResolution changes apply after restarting the game.\nElapsed-time correction stays active when switching the cap. Unlocking remains experimental.", L"全画面・垂直同期・ブルーム・字幕・30 FPS制限は即時適用されます。\n解像度はゲーム再起動後に適用されます。\n制限切替時も時間補正を維持します。制限解除は実験機能です。")
MACROSS_UI_STRING("input.keyboard.open", L"키 설정 (키보드)...", L"Keyboard bindings...", L"キーボード設定...")
MACROSS_UI_STRING("controller.bindings.open", L"패드 버튼 설정...", L"Controller bindings...", L"パッドボタン設定...")
MACROSS_UI_STRING("controller.test.open", L"컨트롤러 테스트...", L"Controller test...", L"コントローラーテスト...")
MACROSS_UI_STRING("options.open", L"옵션 (그래픽·키 설정)...\tF9", L"Options (graphics and input)...\tF9", L"オプション (描画・入力)...\tF9")
MACROSS_UI_STRING("options.fullscreen.menu", L"전체화면\tF11", L"Fullscreen\tF11", L"全画面\tF11")
MACROSS_UI_STRING("options.menu", L"옵션(&O)", L"Options(&O)", L"オプション(&O)")
MACROSS_UI_STRING("options.system_menu", L"옵션 (그래픽·키 설정) (F9)", L"Options (graphics and input) (F9)", L"オプション (描画・入力) (F9)")
