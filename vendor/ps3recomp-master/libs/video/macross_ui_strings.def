/* Stable native UI keys; each row supplies KO / EN / JA text. */
MACROSS_UI_STRING("options.hd_textures", L"고해상도 텍스처 (재시작 후 적용)", L"High-resolution textures (restart required)", L"高解像度テクスチャ (再起動後に適用)")
MACROSS_UI_STRING("options.hd_textures.help", L"미리보기용 텍스처를 전투에 사용하기", L"Use preview textures in battle", L"プレビュー用テクスチャを戦闘で使用")
MACROSS_UI_STRING("music.title", L"커스텀 음악", L"Custom music", L"カスタム音楽")
MACROSS_UI_STRING("music.folder", L"음원 폴더 (MP3 · WAV)", L"Music folder (MP3 / WAV)", L"音楽フォルダー (MP3・WAV)")
MACROSS_UI_STRING("music.choose", L"폴더 선택", L"Choose folder", L"フォルダーを選択")
MACROSS_UI_STRING("music.open_folder", L"폴더 열기", L"Open folder", L"フォルダーを開く")
MACROSS_UI_STRING("music.refresh", L"목록 새로고침", L"Refresh library", L"一覧を更新")
MACROSS_UI_STRING("music.track_count", L"인식한 음원: %d곡", L"Tracks found: %d", L"認識した曲数: %d")
MACROSS_UI_STRING("music.scan_error", L"폴더를 읽지 못했습니다. 폴더 위치와 접근 권한을 확인하세요.", L"Cannot read this folder. Check its location and access permissions.", L"フォルダーを読み込めません。場所とアクセス権限を確認してください。")
MACROSS_UI_STRING("music.folder_error", L"폴더 설정을 저장하지 못했습니다.", L"Could not save the folder setting.", L"フォルダー設定を保存できませんでした。")
MACROSS_UI_STRING("music.help", L"음원을 넣고 새로고침한 뒤 게임의 커스텀 사운드 편집을 다시 여세요.\n기본 폴더: CustomMusic · 최대 512곡 · 하위 폴더 포함", L"Add music, refresh, then reopen Custom Sound editing in the game.\nDefault: CustomMusic · Up to 512 tracks, including subfolders", L"曲を追加して一覧を更新し、ゲームのカスタムサウンド編集を開き直してください。\n初期フォルダー: CustomMusic・最大512曲・サブフォルダー対応")
MACROSS_UI_STRING("input.none", L"(없음)", L"(none)", L"(なし)")
MACROSS_UI_STRING("input.key_code", L"키 0x%02X", L"Key 0x%02X", L"キー 0x%02X")
MACROSS_UI_STRING("input.key_prompt", L"키를 누르세요 (Esc 취소, Del 해제)", L"Press a key (Esc cancel, Del clear)", L"キーを押してください (Esc取消、Del解除)")
MACROSS_UI_STRING("input.keyboard.title", L"키 설정 (키보드)", L"Keyboard bindings", L"キーボード設定")
MACROSS_UI_STRING("input.keyboard.help", L"컨트롤러와 키보드를 함께 쓸 수 있습니다. 바꾼 키는 바로 적용됩니다.\n왼쪽 스틱에 키를 지정하지 않으면 방향키가 왼쪽 스틱도 움직입니다.", L"Controller and keyboard can be used together. Changes apply immediately.\nArrow keys also control the left stick unless bindings are assigned.", L"パッドとキーボードを併用できます。変更はすぐに適用されます。\n左スティックにキーが未設定の場合は方向キーでも操作できます。")
MACROSS_UI_STRING("common.defaults", L"기본값으로", L"Defaults", L"初期設定")
MACROSS_UI_STRING("common.close", L"닫기", L"Close", L"閉じる")
MACROSS_UI_STRING("controller.dualsense", L"듀얼센스 (PS5)", L"DualSense (PS5)", L"DualSense (PS5)")
MACROSS_UI_STRING("controller.dualshock4", L"듀얼쇼크4 (PS4)", L"DualShock 4 (PS4)", L"DualShock 4 (PS4)")
