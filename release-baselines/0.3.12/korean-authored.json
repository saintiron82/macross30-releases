{
  "source_elf_sha256": "3e29d7c62adbabf2c7ae1e8799737cbdf16617d8b87958daeed298364aff1a0b",
  "entries": [
    {
      "offset": "0x909cf8",
      "source": "遺跡の眠り姫",
      "source_sha256": "85400dd51bb24c480414640e9c1ada1f3a712771ee09448782249c2dc3314983",
      "translation": "유적의 잠든 공주",
      "capacity": 24,
      "target_bytes": 24
    },
    {
      "offset": "0x913378",
      "source": "ファストパック",
      "source_sha256": "85af16ffc9fce42ac33ee2cc7a14d25ef06aba7e3c4721a5ba9f17332099eef7",
      "translation": "FAST 팩",
      "capacity": 24,
      "target_bytes": 9
    },
    {
      "offset": "0x913390",
      "source": "VF-0用ファストパック",
      "source_sha256": "7ca28a22e13d253e4c627d521f22bb13f7b33971bafd6fa055724e59265e554d",
      "translation": "VF-0용 FAST 팩",
      "capacity": 32,
      "target_bytes": 17
    },
    {
      "offset": "0x9133c0",
      "source": "全弾発射",
      "source_sha256": "a4675f200aa51079c27ffc4bb90c42aa91421c5561bc29b60d8d8a908442b2c9",
      "translation": "전탄 발사",
      "capacity": 16,
      "target_bytes": 14
    },
    {
      "offset": "0x9133f0",
      "source": "ＶＦ－０用の追加装備。\nエンジンナセルに装着するパーツで、\nミサイルと燃料タンクが内蔵されている。",
      "source_sha256": "b6b3d57e6eed75202b114fd22deb9f6871efef3c43d1b90b3e44765622e4c850",
      "translation": "VF-0용 추가 장비.\n엔진 나셀에 장착하는 부품으로,\n미사일과 연료통가 내장되어 있다.",
      "capacity": 144,
      "target_bytes": 114
    },
    {
      "offset": "0x913480",
      "source": "ゴーストブースター",
      "source_sha256": "dba28a2a16c82e3c69a171b44a6aa9b2a573152c359f234d8ac7c430dad2914a",
      "translation": "고스트 부스터",
      "capacity": 32,
      "target_bytes": 20
    },
    {
      "offset": "0x9134a0",
      "source": "VF-0用ゴーストブースター",
      "source_sha256": "1768ee3720ebdd154cf0e8d52cc8a60a9dfd8ee0bd21f823bc309ebc32440b64",
      "translation": "VF-0용 고스트 부스터",
      "capacity": 40,
      "target_bytes": 28
    },
    {
      "offset": "0x9134e8",
      "source": "ＶＦ－０用の追加装備。\n無人偵察機「ゴースト」をブースターパックとして使用し、\n機体上面や主翼下部にもミサイルパックが\n増設されている。",
      "source_sha256": "8b2a28294c55ad5623906b72be09f44d3dfbf5965db04175ebd810580b86964d",
      "translation": "VF-0용 추가 장비.\n무인 정찰기 「고스트」를 부스터 팩으로 사용하며,\n기체 윗면과 주익 아래에도 미사일 팩이\n추가 장착되어 있다.",
      "capacity": 200,
      "target_bytes": 175
    },
    {
      "offset": "0x9135b0",
      "source": "ツインブースター",
      "source_sha256": "b58b76f4425bbb65521b69456f029bb5ccf841db97233eb6d3c31ff805f7ed85",
      "translation": "트윈 부스터",
      "capacity": 32,
      "target_bytes": 17
    },
    {
      "offset": "0x9135d0",
      "source": "SV-51用ツインブースター",
      "source_sha256": "70b27160311a8c12b5ab16761cfb0cfaa06db69ad70a84ff730660fd3cdba083",
      "translation": "SV-51용 트윈 부스터",
      "capacity": 40,
      "target_bytes": 26
    },
    {
      "offset": "0x913618",
      "source": "ＳＶ－５１用の追加装備。\nロケットブースター２基と、追加武装として各種ミサイルが\n装備されており、機動性と火力が強化される。",
      "source_sha256": "ef615659ebcd46dff3d913506b12b5a99750ef6884f5926addfb02b64e949105",
      "translation": "SV-51용 추가 장비.\n로켓 부스터 2기와 각종 미사일을 추가 무장으로\n장착하여 기동성과 화력이 강화된다.",
      "capacity": 184,
      "target_bytes": 139
    },
    {
      "offset": "0x9136d0",
      "source": "スーパーパック",
      "source_sha256": "0d58b55be4cc171005a9686887ccd8336fb43b27d945dd41d5eaa649e507571d",
      "translation": "슈퍼 팩",
      "capacity": 24,
      "target_bytes": 11
    },
    {
      "offset": "0x9136e8",
      "source": "VF-1用スーパーパック",
      "source_sha256": "1d620f00bfdbf716899b3d7fe502b480b83af9541ebfa30b35a945c0d6eeb5f6",
      "translation": "VF-1용 슈퍼 팩",
      "capacity": 32,
      "target_bytes": 19
    },
    {
      "offset": "0x913718",
      "source": "ＶＦ－１用の追加装備。\n大型ブースターとミサイルポッドにより、\n火力・加速力・機動性が強化される。",
      "source_sha256": "d32e88d762479b67eed0929193aed1765b15d2ab0cc85de25694a4450b09d363",
      "translation": "VF-1용 추가 장비.\n대형 부스터와 미사일 포드로\n화력·가속력·기동성이 강화된다.",
      "capacity": 144,
      "target_bytes": 109
    },
    {
      "offset": "0x9137a8",
      "source": "ストライクパック",
      "source_sha256": "cc343513d21cec5fb105d833b242246488071af5a1fb0d5a981003537f5fc583",
      "translation": "스트라이크 팩",
      "capacity": 32,
      "target_bytes": 20
    },
    {
      "offset": "0x9137c8",
      "source": "VF-1用ストライクパック",
      "source_sha256": "a401ff8d9ff3eb4408c0f1f54136aa789ff0cb83a60669227a3026e532150c7c",
      "translation": "VF-1용 스트라이크 팩",
      "capacity": 32,
      "target_bytes": 28
    },
    {
      "offset": "0x913808",
      "source": "ＶＦ－１用の追加装備。\nスーパーパックではミサイルポッドだった\n右ブースターの武装を連装ビーム砲に変更し、\n更なる火力の向上が図られている。",
      "source_sha256": "26a6d2af9a924e8de1561341a12d02ace472d41e779e6acf1c7009bddb622bb2",
      "translation": "VF-1용 추가 장비.\n슈퍼 팩에서는 미사일 포드였던\n오른쪽 부스터의 무장을 2연장 빔포로 바꾸어,\n화력을 더욱 높였다.",
      "capacity": 208,
      "target_bytes": 156
    },
    {
      "offset": "0x9138d8",
      "source": "Wストライクパック",
      "source_sha256": "c203a00d7cdd1c025cbc4861a7fcbc371378149026d7d1284267ada2830b6c47",
      "translation": "W 스트라이크 팩",
      "capacity": 32,
      "target_bytes": 22
    },
    {
      "offset": "0x9138f8",
      "source": "VF-1用Ｗストライクパック",
      "source_sha256": "c8bbfc7def37da79d875fea74adec8dd3be6d4450aa137fb7695fbd7b9a570c6",
      "translation": "VF-1용 W 스트라이크 팩",
      "capacity": 40,
      "target_bytes": 30
    },
    {
      "offset": "0x913920",
      "source": "ダブル超射撃",
      "source_sha256": "02bb54606f2285413f8ec0fafb0b3ac857de88cc90121e3a7ef28fe6068cadd4",
      "translation": "더블 초사격",
      "capacity": 24,
      "target_bytes": 17
    },
    {
      "offset": "0x913958",
      "source": "ＶＦ－１用の追加装備。\nダブルストライクパックでは両方のブースターの武装を\n連装ビーム砲に変更し、ストライクパック以上の火力を有する。",
      "source_sha256": "095c480ea91d7e5a3f2e6a36576c04af69fa144a6afca46168322b8d53dcc347",
      "translation": "VF-1용 추가 장비.\n더블 스트라이크 팩은 양쪽 부스터의 무장을\n2연장 빔포로 바꾸어 스트라이크 팩보다 화력이 높다.",
      "capacity": 200,
      "target_bytes": 155
    },
    {
      "offset": "0x913a20",
      "source": "VF-11B用スーパーパック",
      "source_sha256": "7c4d60e10aaac32f5eaf345a3d0d680319709d7a1fc907ad9b4c473958fd4324",
      "translation": "VF-11B용 슈퍼 팩",
      "capacity": 32,
      "target_bytes": 21
    },
    {
      "offset": "0x913a60",
      "source": "ＶＦ－１１Ｂ用の追加装備。\nブースターとミサイルポッドにより、\n推力と火力が強化される。また、ブースターが\nコンパクトになりバトロイド形態時の運動性も良好。",
      "source_sha256": "990bfca2052c77f3d219394ec85fb668d68a191fe271660d72ea560de3c081d2",
      "translation": "VF-11B용 추가 장비.\n부스터와 미사일 포드로\n추력과 화력이 강화된다. 또한 소형화된 부스터로\n배틀로이드 형태에서도 운동성이 좋다.",
      "capacity": 232,
      "target_bytes": 178
    },
    {
      "offset": "0x913b48",
      "source": "VF-11C用スーパーパック",
      "source_sha256": "232052b6b40362ef99225d1776ecafc10b9057c97a933c1b57b9c9e76750abe4",
      "translation": "VF-11C용 슈퍼 팩",
      "capacity": 32,
      "target_bytes": 21
    },
    {
      "offset": "0x913b88",
      "source": "ＶＦ－１１Ｃ用の追加装備。\nブースターとミサイルポッドにより、\n推力と火力が強化される。また、ブースターが\nコンパクトになりバトロイド形態時の運動性も良好。",
      "source_sha256": "5b37dedff80bcb7b96d978a5dbb0a052ca8caaec6a107497cd4552ee0db9276b",
      "translation": "VF-11C용 추가 장비.\n부스터와 미사일 포드로\n추력과 화력이 강화된다. 또한 소형화된 부스터로\n배틀로이드 형태에서도 운동성이 좋다.",
      "capacity": 232,
      "target_bytes": 178
    },
    {
      "offset": "0x913c70",
      "source": "YF-19用ファストパック",
      "source_sha256": "2da0016a83f857ff701db5a556ebd7aa224162bc954fba3f3ab04d8b62368f26",
      "translation": "YF-19용 FAST 팩",
      "capacity": 32,
      "target_bytes": 18
    },
    {
      "offset": "0x913cb0",
      "source": "ＹＦ－１９用の追加装備。\n推力の上昇を目的としたブースター類は無く、ミサイル\nランチャーやアーマーユニット、機動性の低下を補う\n高機動バーニアのみで構成されている。",
      "source_sha256": "bb03d7ec39db44c2ed476b8c9ea2fb4ec6302bba4b99a29764c1d3d85ae80b68",
      "translation": "YF-19용 추가 장비.\n추력 향상용 부스터 없이 미사일 런처와\n아머 유닛, 기동성 저하를 보완하는\n고기동 버니어만으로 구성된다.",
      "capacity": 248,
      "target_bytes": 169
    },
    {
      "offset": "0x913da8",
      "source": "YF-21用ファストパック",
      "source_sha256": "a35f0ee099860c638c16365cd61536ed0bfc5f27bcd379214e4cbf15d367714e",
      "translation": "YF-21용 FAST 팩",
      "capacity": 32,
      "target_bytes": 18
    },
    {
      "offset": "0x913de8",
      "source": "ＹＦ－２１、ＶＦ－２２用の追加装備。\n推力の上昇を目的としたブースター類は無く、ミサイル\nランチャーや増槽のみで構成されている。",
      "source_sha256": "62140a5c82b08b31fd4a4988cc3cd2f114fc700a278608b71812a5b096d10228",
      "translation": "YF-21, VF-22용 추가 장비.\n추력 향상용 부스터 없이 미사일\n런처와 보조 연료통만으로 구성된다.",
      "capacity": 192,
      "target_bytes": 125
    },
    {
      "offset": "0x913ea8",
      "source": "アーマードパック",
      "source_sha256": "5f309dea1018b58b242322c86c75431e3834eee85cf80d5260a8ae630633c77c",
      "translation": "아머드 팩",
      "capacity": 32,
      "target_bytes": 14
    },
    {
      "offset": "0x913ec8",
      "source": "VF-171EX用アーマードパック",
      "source_sha256": "1229eaaf99146ae8603df3589a850dc9e6c1339a79d1fa1d34b51def4699bf95",
      "translation": "VF-171EX용 아머드 팩",
      "capacity": 40,
      "target_bytes": 26
    },
    {
      "offset": "0x913f18",
      "source": "ＶＦ－１７１ＥＸ用の追加装備。\n胸部や脚部を覆うプロテクターに装備された\n小型バーニアやミサイルにより、\n火力・防御力・機動性が向上する。",
      "source_sha256": "6892009108fc7695135e35dde9a907a88eacfc6684a9539dff984556d434d2d9",
      "translation": "VF-171EX용 추가 장비.\n가슴과 다리를 덮는 보호대에 장착된\n소형 버니어와 미사일로\n화력·방어력·기동성이 향상된다.",
      "capacity": 208,
      "target_bytes": 156
    },
    {
      "offset": "0x913fe8",
      "source": "VF-25用スーパーパック",
      "source_sha256": "4eba488796fa248130d89f535947edef0f21cabad785f7bdb886e77318fd27e3",
      "translation": "VF-25용 슈퍼 팩",
      "capacity": 32,
      "target_bytes": 20
    },
    {
      "offset": "0x914028",
      "source": "ＶＦ－２５用の追加装備。\nメイン／サブ合わせて４基のブースターユニットと、\nミサイルなどの武装、追加装甲パネルで構成された\n全体的なバランスの取れたパック。",
      "source_sha256": "e8b58e948d07b26ce2d14e1442e11fa7410561ea9334d1b49c8988eb84ebfb0d",
      "translation": "VF-25용 추가 장비.\n주·보조 부스터 유닛 총 4기와\n미사일 등의 무장, 추가 장갑 패널로 구성된\n전체적으로 균형 잡힌 팩이다.",
      "capacity": 232,
      "target_bytes": 165
    },
    {
      "offset": "0x914110",
      "source": "VF-25用アーマードパック",
      "source_sha256": "bc7fd5d049c3d1ab44c21246e69e043799f357d620393cff2020ec90b2b67230",
      "translation": "VF-25용 아머드 팩",
      "capacity": 40,
      "target_bytes": 23
    },
    {
      "offset": "0x914158",
      "source": "ＶＦ－２５用の追加装備。\n頭以外をカバーする重装甲と、全身に装備された多数の\n武装により、非常に高い防御力と火力を持つパック。",
      "source_sha256": "33c02e1955168539af876497f3f9b0f389afe067bb3318e2c4306381f1823e4e",
      "translation": "VF-25용 추가 장비.\n머리 외 전신을 덮는 중장갑과 온몸에 장착된\n다수의 무장으로 매우 높은 방어력과 화력을 갖춘 팩.",
      "capacity": 192,
      "target_bytes": 157
    },
    {
      "offset": "0x914218",
      "source": "トルネードパック",
      "source_sha256": "8bb258af8e81120f5bf742eee6636e2e89a2d6a66067d9b711c9f3b4c7d34cff",
      "translation": "토네이도 팩",
      "capacity": 32,
      "target_bytes": 17
    },
    {
      "offset": "0x914238",
      "source": "VF-25用トルネードパック",
      "source_sha256": "e3839d43fc88232862674003069b4ae694f0f8d434f931db67a991153d5fc755",
      "translation": "VF-25용 토네이도 팩",
      "capacity": 40,
      "target_bytes": 26
    },
    {
      "offset": "0x914290",
      "source": "ＶＦ－２５用の追加装備。\n４基の可動式高機動バーニア、マイクロミサイルポッド\nや旋回式連装ビーム砲などで構成されており、\n非常に高い機動性と火力を持つ。",
      "source_sha256": "f9965e0b28160442e00dbee37b7f6d4c4d06769a54f17c5108895fa7f549cb2e",
      "translation": "VF-25용 추가 장비.\n가동식 고기동 버니어 4기와 마이크로 미사일 포드,\n회전식 2연장 빔포 등으로 구성되어\n매우 높은 기동성과 화력을 갖췄다.",
      "capacity": 224,
      "target_bytes": 189
    },
    {
      "offset": "0x914370",
      "source": "VF-27用スーパーパック",
      "source_sha256": "04b3fa32c95e6edd0a88d222ae891fd9578d3d20c3c0b5cc9cb45dd50571fa60",
      "translation": "VF-27용 슈퍼 팩",
      "capacity": 32,
      "target_bytes": 20
    },
    {
      "offset": "0x9143b0",
      "source": "ＶＦ－２７用の追加装備。\n背面と脚部に装備されるパーツで、追加のロケット\nブースターと推進剤のみで構成されている。これにより\n大推力を誇るＶＦ－２７の機動性がさらに向上する。",
      "source_sha256": "b8d4988a902ef9d0203b2eba4763eac2da16aa6d401136f3aea7ec763aa40479",
      "translation": "VF-27용 추가 장비.\n등과 다리에 장착하는 부품으로, 추가 로켓\n부스터와 추진제로만 구성된다. 이를 통해\n강력한 추력을 자랑하는 VF-27의 기동성이 더 높아진다.",
      "capacity": 256,
      "target_bytes": 212
    },
    {
      "offset": "0x9144b0",
      "source": "YF-29用スーパーパック",
      "source_sha256": "347c6a60fe7d1c2e11c105f0a938f3874ff2abd7f127d09ffea5908cc160076f",
      "translation": "YF-29용 슈퍼 팩",
      "capacity": 32,
      "target_bytes": 20
    },
    {
      "offset": "0x9144f0",
      "source": "ＹＦ－２９用の追加装備。\n２基の化学ロケットブースターやマイクロミサイルポッドが\n装備されており、推力や火力が強化される。",
      "source_sha256": "57ae699f0e90a2b92df1236405943716feb1407405a6033a7da70cd776ea92d5",
      "translation": "YF-29용 추가 장비.\n화학 로켓 부스터 2기와 마이크로 미사일 포드를\n장착하여 추력과 화력이 강화된다.",
      "capacity": 184,
      "target_bytes": 136
    },
    {
      "offset": "0x9170d8",
